# Public values only. NEVER place a Supabase service-role key in a mobile app.
# Physical phone: use your PC's LAN IP. Android emulator: http://10.0.2.2:4000
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-publishable-or-anon-key
# Explicit, development-only local fixtures. This never grants a server role.
EXPO_PUBLIC_DEMO_MODE=false
