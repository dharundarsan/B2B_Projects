{
  "expo": {
    "name": "RepairLedger",
    "slug": "repairledger-mobile",
    "version": "0.1.0",
    "scheme": "repairledger",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.repairledger.mobile",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.repairledger.mobile",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": { "bundler": "metro", "output": "single", "name": "RepairLedger mobile preview" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-image-picker", {
        "photosPermission": "Attach a photo to your maintenance report.",
        "cameraPermission": "Take a photo of a maintenance problem.",
        "microphonePermission": false
      }]
    ]
  }
}
